# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y18 [get_cells shell_i/ps7_0/inst/buffer_fclk_clk_2.FCLK_CLK_2_BUFG]
set_property LOC BUFGCTRL_X0Y17 [get_cells shell_i/ps7_0/inst/buffer_fclk_clk_1.FCLK_CLK_1_BUFG]
set_property LOC BUFGCTRL_X0Y16 [get_cells shell_i/ps7_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG]
set_property LOC BUFGCTRL_X0Y1 [get_cells shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells shell_i/clk_wiz_hdmi/inst/clkout1_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports

# Clock net "shell_i/ps7_0/inst/FCLK_CLK2" driven by instance "shell_i/ps7_0/inst/buffer_fclk_clk_2.FCLK_CLK_2_BUFG" located at site "BUFGCTRL_X0Y18"
#startgroup
create_pblock {CLKAG_shell_i/ps7_0/inst/FCLK_CLK2}
add_cells_to_pblock [get_pblocks  {CLKAG_shell_i/ps7_0/inst/FCLK_CLK2}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="shell_i/ps7_0/inst/FCLK_CLK2"}]]]
resize_pblock [get_pblocks {CLKAG_shell_i/ps7_0/inst/FCLK_CLK2}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "shell_i/ps7_0/inst/FCLK_CLK1" driven by instance "shell_i/ps7_0/inst/buffer_fclk_clk_1.FCLK_CLK_1_BUFG" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_shell_i/ps7_0/inst/FCLK_CLK1}
add_cells_to_pblock [get_pblocks  {CLKAG_shell_i/ps7_0/inst/FCLK_CLK1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="shell_i/ps7_0/inst/FCLK_CLK1"}]]]
resize_pblock [get_pblocks {CLKAG_shell_i/ps7_0/inst/FCLK_CLK1}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "shell_i/ps7_0/inst/FCLK_CLK0" driven by instance "shell_i/ps7_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_shell_i/ps7_0/inst/FCLK_CLK0}
add_cells_to_pblock [get_pblocks  {CLKAG_shell_i/ps7_0/inst/FCLK_CLK0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=shell_i/clk_wiz_hdmi/inst/mmcm_adv_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="shell_i/ps7_0/inst/FCLK_CLK0"}]]]
resize_pblock [get_pblocks {CLKAG_shell_i/ps7_0/inst/FCLK_CLK0}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG" driven by instance "shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG_inst" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_shell_i/clk_wiz_hdmi/inst/clk_out2_BUFG}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "shell_i/clk_wiz_hdmi/inst/clk_out1" driven by instance "shell_i/clk_wiz_hdmi/inst/clkout1_buf" located at site "BUFGCTRL_X0Y0"
#startgroup
